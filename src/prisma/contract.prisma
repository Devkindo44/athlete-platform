// use prisma-8

enum UserRole {
  MEMBER
  ATHLETE
  COACH
  ADMIN
}

enum SubscriptionTier {
  FREE
  GOLD
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum DonationFrequency {
  ONE_TIME
  MONTHLY
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum MediaType {
  VIDEO
  PHOTO
  COMPETITION_LINK
}

enum AccessTier {
  PUBLIC
  GOLD
  PREMIUM
}

enum CommentStatus {
  PENDING
  APPROVED
  HIDDEN
  REJECTED
}

enum ReactionType {
  LIKE
  FIRE
  CLAP
  TROPHY
}

model User {
  id               Int               @id @default(autoincrement())
  email            String            @unique
  username         String?           @unique
  name             String?
  passwordHash     String?
  role             UserRole          @default(MEMBER)
  preferredLocale  String            @default("fr")
  stripeCustomerId String?           @unique
  subscription     Subscription?
  donations        Donation[]
  athleteProfiles  AthleteProfile[]
  posts            Post[]
  mediaAssets      MediaAsset[]
  comments         Comment[]
  commentReactions CommentReaction[]
  createdAt        DateTime          @default(now()) @onCreate(now())
  updatedAt        temporal.UpdatedAt
}

model AthleteProfile {
  id        Int                @id @default(autoincrement())
  userId    Int
  user      User               @relation(fields: [userId], references: [id])
  sport     String
  level     String?
  goal      String?
  bio       String?
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@index([userId])
  @@unique([userId, sport])
}

model Post {
  id        Int                @id @default(autoincrement())
  title     String
  content   String?
  author    User               @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model Subscription {
  id                   Int                @id @default(autoincrement())
  userId               Int                @unique
  user                 User               @relation(fields: [userId], references: [id])
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(INCOMPLETE)
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now()) @onCreate(now())
  updatedAt            temporal.UpdatedAt
}

model Donation {
  id                    Int               @id @default(autoincrement())
  donorId               Int?
  donor                 User?             @relation(fields: [donorId], references: [id])
  donorName             String?
  donorEmail            String?
  amountCents           Int
  currency              String            @default("eur")
  frequency             DonationFrequency @default(ONE_TIME)
  status                DonationStatus    @default(PENDING)
  message               String?
  isAnonymous           Boolean           @default(false)
  isPublicOnWall        Boolean           @default(true)
  campaignSlug          String?
  stripePaymentIntentId String?           @unique
  stripeSubscriptionId  String?           @unique
  createdAt             DateTime          @default(now()) @onCreate(now())
  updatedAt             temporal.UpdatedAt

  @@index([status, isPublicOnWall])
  @@index([campaignSlug])
}

model Competition {
  id            Int          @id @default(autoincrement())
  slug          String       @unique
  title         String
  sport         String
  location      String
  country       String?
  eventDate     DateTime
  resultSummary String?
  externalUrl   String?
  streamUrl     String?
  accessTier    AccessTier   @default(PUBLIC)
  isPublished   Boolean      @default(false)
  mediaAssets   MediaAsset[]
  createdAt     DateTime     @default(now()) @onCreate(now())
  updatedAt     temporal.UpdatedAt

  @@index([eventDate, isPublished])
}

model MediaAsset {
  id            Int                @id @default(autoincrement())
  authorId      Int
  author        User               @relation(fields: [authorId], references: [id])
  competitionId Int?
  competition   Competition?       @relation(fields: [competitionId], references: [id])
  type          MediaType          @default(VIDEO)
  accessTier    AccessTier         @default(PUBLIC)
  streamKey     String?            @unique
  playbackUrl   String
  thumbnailUrl  String?
  durationSec   Int?
  sport         String?
  isPublished   Boolean            @default(false)
  translations  MediaTranslation[]
  comments      Comment[]
  createdAt     DateTime           @default(now()) @onCreate(now())
  updatedAt     temporal.UpdatedAt

  @@index([accessTier, isPublished])
  @@index([competitionId])
}

model MediaTranslation {
  id           Int        @id @default(autoincrement())
  mediaId      Int
  media        MediaAsset @relation(fields: [mediaId], references: [id])
  locale       String
  title        String
  description  String?
  subtitlesUrl String?
  createdAt    DateTime   @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt

  @@unique([mediaId, locale])
}

model Comment {
  id           Int               @id @default(autoincrement())
  mediaId      Int
  media        MediaAsset        @relation(fields: [mediaId], references: [id])
  authorId     Int
  author       User              @relation(fields: [authorId], references: [id])
  parentId     Int?
  content      String
  status       CommentStatus     @default(PENDING)
  isReported   Boolean           @default(false)
  reportReason String?
  reactions    CommentReaction[]
  createdAt    DateTime          @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt

  @@index([mediaId, status])
  @@index([authorId])
  @@index([parentId])
}

model CommentReaction {
  id        Int          @id @default(autoincrement())
  commentId Int
  comment   Comment      @relation(fields: [commentId], references: [id])
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@unique([commentId, userId, type])
  @@index([commentId])
}