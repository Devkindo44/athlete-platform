// use prisma-8

enum UserRole {
  MEMBER
  ATHLETE
  COACH
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model User {
  id               Int              @id @default(autoincrement())
  email            String           @unique
  username         String?          @unique
  name             String?
  passwordHash     String?
  role             UserRole         @default(MEMBER)
  preferredLocale  String           @default("fr")
  stripeCustomerId String?          @unique
  subscription     Subscription?
  athleteProfiles  AthleteProfile[]
  posts            Post[]
  mediaAssets      MediaAsset[]
  createdAt        DateTime         @default(now()) @onCreate(now())
  updatedAt        temporal.UpdatedAt
}

model AthleteProfile {
  id        Int                @id @default(autoincrement())
  userId    Int
  user      User               @relation(fields: [userId], references: [id])
  sport     String
  level     String?
  goal      String?
  bio       String?
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@index([userId])
  @@unique([userId, sport])
}

model Post {
  id        Int                @id @default(autoincrement())
  title     String
  content   String?
  author    User               @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model Subscription {
  id                   Int                @id @default(autoincrement())
  userId               Int                @unique
  user                 User               @relation(fields: [userId], references: [id])
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(INCOMPLETE)
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now()) @onCreate(now())
  updatedAt            temporal.UpdatedAt
}

model MediaAsset {
  id           Int                @id @default(autoincrement())
  authorId     Int
  author       User               @relation(fields: [authorId], references: [id])
  streamKey    String             @unique
  playbackUrl  String
  durationSec  Int
  requiredTier SubscriptionTier   @default(FREE)
  isPublished  Boolean            @default(false)
  translations MediaTranslation[]
  createdAt    DateTime           @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt
}

model MediaTranslation {
  id           Int        @id @default(autoincrement())
  mediaId      Int
  media        MediaAsset @relation(fields: [mediaId], references: [id])
  locale       String
  title        String
  description  String?
  subtitlesUrl String?
  createdAt    DateTime   @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt

  @@unique([mediaId, locale])
}